# =============================================================================
# NESJA.OS website — environment variables
# Copy to .env.local for local development. Everything is optional: with no
# variables set, the site runs fully using development adapters (mock leads,
# mock scheduler, console email, console analytics).
# =============================================================================

# --- Site ---------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000        # Production: https://www.nesja.com (canonical URLs, sitemap, OG)
NEXT_PUBLIC_APP_URL=                              # NESJA application URL (used by Sign In)
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_LEGAL_ENTITY=NESJA
NEXT_PUBLIC_OVERVIEW_VIDEO_URL=                   # Shown after demo booking when set (YouTube/Vimeo embed URL or .mp4)

# Social profiles render only when set to a valid https URL
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_X=

# Feature flags
NEXT_PUBLIC_FEATURE_SELF_SERVE=false              # Shows START FREE / trial CTAs + checkout

# --- Lead capture (src/services/leads) ----------------------------------------
LEAD_ADAPTER=mock                                 # mock | nesja | webhook | hubspot
LEAD_NOTIFICATION_EMAIL=                          # Internal address notified of every lead
NESJA_API_URL=                                    # LEAD_ADAPTER=nesja
NESJA_API_KEY=
LEAD_WEBHOOK_URL=                                 # LEAD_ADAPTER=webhook
LEAD_WEBHOOK_SECRET=                              # optional HMAC signing secret
HUBSPOT_PORTAL_ID=                                # LEAD_ADAPTER=hubspot (also used by NEXT_PUBLIC_HUBSPOT_PORTAL_ID tracking)
HUBSPOT_FORM_GUID=

# --- Demo scheduling (src/services/scheduling) --------------------------------
SCHEDULING_PROVIDER=mock                          # mock | calendly | microsoft-bookings | hubspot | google | custom
SCHEDULING_HOST_TIMEZONE=Asia/Muscat              # Host working-hours timezone (mock + google)
SCHEDULING_HOURS=9-17
SCHEDULING_WORKDAYS=0,1,2,3,4                     # 0=Sun … 6=Sat (Sun–Thu shown; use 1,2,3,4,5 for Mon–Fri)
SCHEDULING_SLOT_MINUTES=30
SCHEDULING_MIN_NOTICE_HOURS=4
SCHEDULING_MEETING_METHOD=Video call
CALENDLY_API_TOKEN=
CALENDLY_EVENT_TYPE_URI=
MS_TENANT_ID=                                     # Microsoft Bookings + Graph email
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_BOOKINGS_BUSINESS_ID=
MS_BOOKINGS_SERVICE_ID=
MS_BOOKINGS_STAFF_IDS=
HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_MEETING_SLUG=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
SCHEDULING_API_URL=                               # SCHEDULING_PROVIDER=custom
SCHEDULING_API_KEY=

# --- Transactional email (src/services/email) ---------------------------------
EMAIL_PROVIDER=console                            # console | resend | sendgrid | microsoft-graph
EMAIL_FROM="NESJA <hello@example.com>"
RESEND_API_KEY=
SENDGRID_API_KEY=
EMAIL_GRAPH_SENDER=                               # mailbox UPN for microsoft-graph

# --- Sign in (src/services/auth) ----------------------------------------------
AUTH_PROVIDER=none                                # none | nesja-app | oidc
AUTH_LOGIN_PATH=/login
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_REDIRECT_URI=

# --- Payments (src/services/payments) — future self-serve ---------------------
PAYMENT_PROVIDER=none                             # none | stripe
STRIPE_SECRET_KEY=
# STRIPE_PRICE_ESSENTIAL_MONTHLY=, STRIPE_PRICE_ESSENTIAL_12M=, … one per edition/term

# --- Analytics (src/lib/analytics) — loaded only after consent ----------------
NEXT_PUBLIC_ANALYTICS_PROVIDERS=console           # comma list: console,gtm,ga4,segment,posthog,mixpanel,hubspot
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_SEGMENT_WRITE_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
NEXT_PUBLIC_MIXPANEL_TOKEN=
NEXT_PUBLIC_HUBSPOT_PORTAL_ID=
