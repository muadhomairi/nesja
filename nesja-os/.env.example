# NESJA.OS Commercial (app.nesja.ai). Copy to .env.local for local work; set in Vercel for staging/production.
NEXT_PUBLIC_APP_URL=https://app.nesja.ai
NEXT_PUBLIC_WEBSITE_URL=https://www.nesja.ai
# Supabase project nesja-os-production (or nesja-os-staging). Settings > API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Server only: transaction pooler connection string (port 6543).
DATABASE_URL=postgres://postgres.YOUR-REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_CA_CERT=
# Protects /api/jobs (Vercel Cron sends it as a bearer token). 32+ random characters.
CRON_SECRET=
# Tenant id of the synthetic Northstar demo (scripts/generate-demo.ts default). Empty = demo off.
DEMO_TENANT_ID=4e000000-0000-4000-8000-000000000001
# Deployed NESJA Engage URL. Empty = launcher shows "Not deployed yet".
NEXT_PUBLIC_ENGAGE_URL=
